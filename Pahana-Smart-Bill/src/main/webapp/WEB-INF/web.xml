<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Pahana Smart Bill</display-name>
    
    <!-- Welcome Pages -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/jsp/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/jsp/error/500.jsp</location>
    </error-page>
    
    <!-- Security Constraints removed: now handled manually in servlets -->
    
    <!-- Character Encoding Filter -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.pahana.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.pahana.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    
    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.pahana.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- Dashboard Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.pahana.controller.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <servlet-class>com.pahana.controller.EmployeeDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <url-pattern>/employee/dashboard</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CustomerDashboardServlet</servlet-name>
        <servlet-class>com.pahana.controller.CustomerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerDashboardServlet</servlet-name>
        <url-pattern>/customer/dashboard</url-pattern>
    </servlet-mapping>
    
    <!-- CRUD Servlets -->
    <servlet>
        <servlet-name>ItemServlet</servlet-name>
        <servlet-class>com.pahana.controller.ItemServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ItemServlet</servlet-name>
        <url-pattern>/items/*</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>com.pahana.controller.CustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/customers/*</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>BillServlet</servlet-name>
        <servlet-class>com.pahana.controller.BillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillServlet</servlet-name>
        <url-pattern>/bills</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BillServlet</servlet-name>
        <url-pattern>/bills/*</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>BillPDFServlet</servlet-name>
        <servlet-class>com.pahana.controller.BillPDFServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillPDFServlet</servlet-name>
        <url-pattern>/bills/pdf/*</url-pattern>
    </servlet-mapping>
    
    <!-- Report Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.pahana.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports/*</url-pattern>
    </servlet-mapping>
    

    
    <servlet>
        <servlet-name>AdminUserManagementServlet</servlet-name>
        <servlet-class>com.pahana.controller.AdminUserManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserManagementServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AdminSettingsServlet</servlet-name>
        <servlet-class>com.pahana.controller.AdminSettingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminSettingsServlet</servlet-name>
        <url-pattern>/admin/settings</url-pattern>
    </servlet-mapping>
    
</web-app>
